    "cli": "bun cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "@types/qrcode": "^1.5.5",
    "tsdown": "^0.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.3.2"
  }
}
